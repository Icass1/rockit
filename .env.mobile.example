# Copy to .env.mobile; existing desktop deployment is independent.
ROCKIT_MOBILE_ORIGIN=https://mobile.music.example
ROCKIT_MOBILE_PORT=3100
NEXT_PUBLIC_BACKEND_URL=https://api.music.example
NEXT_PUBLIC_S3_PUBLIC_ENDPOINT_URL=https://files.music.example
# Optional server-only API address reachable from this container.
BACKEND_INTERNAL_URL=https://api.music.example
# Public Android association; leave both unset until signing identity is configured.
ROCKIT_ANDROID_PACKAGE_ID=
ROCKIT_ANDROID_CERT_SHA256=
