{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "baseUrl": "../..",
        "paths": {
            "@/*": ["packages/shared/src/*"],
            "@rockit/shared": ["packages/shared/src/index.ts"],
            "@rockit/theme": ["packages/theme/src/index.ts"],
            "@rockit/ui": ["packages/ui/src/index.ts"],
            "@rockit/ui/*": ["packages/ui/src/*.ts"],
            "@mobile/*": ["apps/mobile/*"],
            "@rockit/ui/runtime": ["packages/ui/src/runtime.native.ts"],
            "@rockit/ui/theme": ["packages/ui/src/theme.tsx"],
            "@rockit/ui/icons": ["packages/ui/src/icons.native.ts"],
            "@/platform/socket": ["apps/mobile/platform/socket.web.ts"],
            "@/lib/api": ["apps/mobile/lib/api.native.ts"],
            "@/lib/http": ["apps/mobile/lib/http.native.ts"],
            "expo-sharing": [
                "apps/mobile/node_modules/expo-sharing/build/index.d.ts"
            ]
        },
        "types": ["node", "jest"],
        "allowImportingTsExtensions": true,
        "customConditions": ["react-native"],
        "moduleSuffixes": [".native", ""]
    },
    "include": ["native/**/*"]
}
