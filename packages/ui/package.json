{
    "name": "@rockit/ui",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./theme": "./src/theme.tsx",
        "./primitives/ExplicitBadge": {
            "react-native": "./src/primitives/ExplicitBadge.native.tsx",
            "default": "./src/primitives/ExplicitBadge.tsx"
        },
        "./primitives/*": "./src/primitives/*.tsx",
        "./headless/*": "./src/headless/*.ts",
        "./runtime": {
            "browser": "./src/runtime.web.ts",
            "react-native": "./src/runtime.native.ts",
            "default": "./src/runtime.web.ts"
        },
        "./icons": {
            "browser": "./src/icons.web.ts",
            "react-native": "./src/icons.native.ts",
            "default": "./src/icons.web.ts"
        }
    },
    "scripts": {
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@rockit/theme": "workspace:*",
        "react-native-web": "~0.21.0",
        "lucide-react": "^0.487.0",
        "lucide-react-native": "^1.8.0",
        "@rockit/shared": "workspace:*"
    },
    "peerDependencies": {
        "react": "19.2.3",
        "react-native": "0.86.3"
    },
    "devDependencies": {
        "@types/react": "~19.2.4",
        "@types/react-native-web": "^0.19.2"
    }
}
