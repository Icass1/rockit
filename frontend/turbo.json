{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "env": [
                "ROCKIT_VERSION",
                "NEXT_PUBLIC_APP_VERSION",
                "NEXT_PUBLIC_BACKEND_URL"
            ],
            "outputs": [".next/**", "!.next/cache/**", "dist/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "clean": {
            "cache": false
        }
    }
}
