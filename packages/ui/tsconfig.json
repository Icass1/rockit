{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2022", "DOM"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "esModuleInterop": true,
        "paths": {
            "@/*": ["../shared/src/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"]
}
