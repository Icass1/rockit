{
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "dev:web": "pnpm --filter @app/web dev",
        "dev:mobile": "pnpm --filter @app/mobile start",
        "lint": "pnpm --filter @app/web lint",
        "typecheck": "pnpm --filter '!@app/backend' -r typecheck",
        "clean": "turbo clean",
        "clean:all": "turbo clean && rm -rf node_modules",
        "mobile:prebuild": "cd apps/mobile && pnpm prebuild",
        "mobile:build:android": "cd apps/mobile && pnpm build:android",
        "mobile:build:android:dev": "cd apps/mobile && pnpm build:android:dev",
        "mobile:build:android:preview": "cd apps/mobile && pnpm build:android:preview",
        "mobile:build:android:production": "cd apps/mobile && pnpm build:android:production",
        "mobile:build:ios": "cd apps/mobile && pnpm build:ios",
        "mobile:build:ios:dev": "cd apps/mobile && pnpm build:ios:dev",
        "mobile:build:ios:preview": "cd apps/mobile && pnpm build:ios:preview",
        "mobile:build:ios:production": "cd apps/mobile && pnpm build:ios:production",
        "mobile:build:all": "cd apps/mobile && pnpm build:all",
        "mobile:build:all:production": "cd apps/mobile && pnpm build:all:production",
        "mobile:submit:android": "cd apps/mobile && pnpm submit:android",
        "mobile:submit:ios": "cd apps/mobile && pnpm submit:ios",
        "prettier": "pnpm exec prettier --write \"**/*.{ts,tsx}\"",
        "dev:backend": "pnpm --filter @app/backend dev",
        "check:backend": "bash scripts/check-backend.sh",
        "check:frontend": "bash scripts/check-frontend.sh",
        "check": "bash scripts/check-all.sh",
        "build:web": "pnpm --filter @app/web build",
        "build:shared": "pnpm --filter @rockit/shared build",
        "generate:theme": "node scripts/generate-design-tokens.mjs",
        "check:theme": "node scripts/generate-design-tokens.mjs --check",
        "test:frontend:unit": "vitest run",
        "test:frontend:native": "jest --config jest.native.config.cjs --json --outputFile=.test-build/frontend/native-results.json",
        "test:frontend": "pnpm check:frontend:boundaries && pnpm test:frontend:types && pnpm test:frontend:unit && pnpm test:frontend:native && pnpm --filter @app/web test",
        "build:mobile:web": "pnpm --filter @app/mobile build:web",
        "check:frontend:boundaries": "node scripts/check-frontend-boundaries.mjs",
        "test:frontend:types": "tsc -p tests/frontend/tsconfig.json --noEmit && tsc -p tests/frontend/tsconfig.native.json --noEmit",
        "test:frontend:build": "node scripts/build-frontend-fixtures.mjs",
        "test:frontend:browser": "playwright test"
    },
    "devDependencies": {
        "@babel/runtime": "^8.1.0",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@playwright/test": "1.65.0",
        "@react-native/babel-preset": "0.86.3",
        "@react-native/jest-preset": "0.86.3",
        "@rockit/shared": "workspace:*",
        "@rockit/theme": "workspace:*",
        "@rockit/ui": "workspace:*",
        "@testing-library/react": "16.3.3",
        "@testing-library/react-native": "14.1.0",
        "@testing-library/user-event": "14.6.8",
        "@types/jest": "29.5.14",
        "@types/node": "^24.19.2",
        "@types/react": "19.2.14",
        "@types/ws": "^8.18.2",
        "babel-jest": "29.7.0",
        "eslint": "^9",
        "eslint-config-next": "16.1.6",
        "fake-indexeddb": "^6.2.7",
        "jest": "29.7.0",
        "jsdom": "31.0.0",
        "prettier": "3.9.6",
        "prettier-plugin-tailwindcss": "0.7.4",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.3",
        "test-renderer": "1.3.1",
        "ts-morph": "^28.0.0",
        "tsx": "^4.23.15",
        "turbo": "^2.3.3",
        "typescript": "^5.7.2",
        "vitest": "5.1.0",
        "ws": "8.19.0"
    },
    "packageManager": "pnpm@11.0.8",
    "name": "rockit",
    "private": true
}
