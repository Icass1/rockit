{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend (uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/apps/backend",
            "python": "${workspaceFolder}/apps/backend/.venv/bin/python",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Web (Next.js)",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/apps/web",
            "runtimeExecutable": "systemd-run",
            "runtimeArgs": [
                "--user",
                "--scope",
                "--property=MemoryMax=3G",
                "pnpm",
                "run",
                "dev"
            ],
            "console": "integratedTerminal",
            "autoAttachChildProcesses": true,
            "serverReadyAction": {
                "pattern": "- Local: +(http|https)://localhost:([0-9]+)/",
                "uriFormat": "http://localhost:%s",
                "action": "debugWithChrome"
            },
            "restart": true,
            "webRoot": "${workspaceFolder}/apps/web"
        },
        {
            "name": "Mobile (Expo)",
            "type": "reactnative",
            "request": "launch",
            "cwd": "${workspaceFolder}/apps/mobile",
            "platform": "expo",
            "sourceMaps": true
        }
    ],
    "compounds": [
        {
            "name": "Backend + Web + Mobile",
            "configurations": [
                "Backend (uvicorn)",
                "Web (Next.js)",
                "Mobile (Expo)"
            ],
            "stopAll": true
        },
        {
            "name": "Backend + Web",
            "configurations": ["Backend (uvicorn)", "Web (Next.js)"],
            "stopAll": true
        }
    ]
}
