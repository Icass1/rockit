# Example values only: use a dedicated deployed mobile origin and your own signing key.
ROCKIT_MOBILE_ORIGIN=https://mobile.music.example
ROCKIT_ANDROID_PACKAGE_ID=org.example.rockit.mobile
ROCKIT_ANDROID_CERT_SHA256=
ROCKIT_ANDROID_KEYSTORE=/absolute/path/to/rockit-upload.jks
ROCKIT_ANDROID_KEY_ALIAS=rockit
ROCKIT_ANDROID_VERSION_CODE=1
ROCKIT_ANDROID_VERSION_NAME=1.0.0
